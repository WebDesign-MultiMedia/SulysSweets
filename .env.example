# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret — after deploying, create an endpoint in the
# Stripe Dashboard (Developers > Webhooks) pointing to
# https://<your-domain>/api/webhook, listening for "checkout.session.completed".
# Copy the "Signing secret" it gives you into this variable.
STRIPE_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="Suly's Sweets <orders@sulyssweets.com>"

# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
